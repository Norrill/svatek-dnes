    "Aplikace nemá přístup ke kalendáři. Povolte jej v Nastavení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has no access to your calendar. You can allow it in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat keinen Zugriff auf Ihren Kalender. Sie können ihn in den Einstellungen erlauben."
          }
        }
      }
    },
    "Aplikace porovná jména ve vašich kontaktech s kalendářem a připomene vám, kdo má svátek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app matches the first names in your contacts with the calendar and reminds you who has a name day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App vergleicht die Vornamen Ihrer Kontakte mit dem Kalender und erinnert Sie daran, wer Namenstag hat."
          }
        }
      }
    },
    "Aplikace porovná křestní jména z vašich kontaktů s kalendářem jmenin a ukáže, kdo má kdy svátek. Vše probíhá jen ve vašem zařízení – kontakty nikam neodesíláme.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app matches the first names from your contacts with the name day calendar and shows who celebrates when. Everything happens on your device – contacts are never uploaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App vergleicht die Vornamen Ihrer Kontakte mit dem Namenstagskalender und zeigt, wer wann feiert. Alles geschieht nur auf Ihrem Gerät – Kontakte werden nirgendwohin gesendet."
          }
        }
      }
    },
    "bez jmenin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no name day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kein Namenstag"
          }
        }
      }
    },
    "Bez jmenin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name day"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Namenstag"
          }
        }
      }
    },
    "Bez přiřazeného svátku": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name day assigned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne zugewiesenen Namenstag"
          }
        }
      }
    },
    "Bez přístupu ke kontaktům nemůžeme zjistit, kdo z vašich blízkých slaví svátek. Přístup můžete kdykoli povolit v Nastavení.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without access to your contacts we cannot tell who of your loved ones celebrates a name day. You can allow access anytime in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Zugriff auf Ihre Kontakte können wir nicht feststellen, wer von Ihren Liebsten Namenstag feiert. Sie können den Zugriff jederzeit in den Einstellungen erlauben."
          }
        }
      }
    },
