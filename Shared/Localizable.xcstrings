    "people_intro_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace porovná křestní jména z vašich kontaktů s kalendářem jmenin a ukáže, kdo má kdy svátek. Vše probíhá jen ve vašem zařízení – kontakty nikam neodesíláme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app matches the first names from your contacts with the name day calendar and shows who celebrates when. Everything happens on your device – contacts are never uploaded."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App vergleicht die Vornamen Ihrer Kontakte mit dem Namenstagskalender und zeigt, wer wann feiert. Alles geschieht nur auf Ihrem Gerät – Kontakte werden nirgendwohin gesendet."
          }
