    "Aktualizace se nepodařila – zkusíme to později automaticky.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update failed – we'll retry automatically later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktualisierung ist fehlgeschlagen – wir versuchen es später automatisch erneut."
          }
        }
      }
    },
    "Aktualizovat nyní": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update now"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt aktualisieren"
          }
        }
