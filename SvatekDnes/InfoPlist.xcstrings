      "comment" : "Privacy - Calendars Write Only Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Aplikace přidá událost se svátkem do vašeho kalendáře."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App fügt Ihrem Kalender ein Namenstag-Ereignis hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The app adds a name day event to your calendar."
          }
